# Clé API OpenAI
OPENAI_API_KEY=sk-...

# Modèle LLM
MODEL=gpt-4o-mini

# Température (0 = déterministe)
TEMPERATURE=0

# Nombre maximum de tokens en sortie
MAX_TOKENS=2048

# Modèle d'embeddings OpenAI
EMBEDDING_MODEL=text-embedding-3-small

# RAG — chemin vers les PDFs ISTQB (relatif au répertoire agent/)
ISTQB_DOCS_DIR=../pdf

# RAG — nom de la collection ChromaDB
CHROMA_COLLECTION=istqb_best_practices

# Endpoint REST des user stories (GET → tableau JSON)
# Par défaut : dataset statique GitHub (github-user-stories-fake-api)
US_API_ENDPOINT=https://raw.githubusercontent.com/mickaellherminez/github-user-stories-fake-api/main/data/user-stories.json

# ChromaDB : chemin de persistance locale
CHROMA_PERSIST_DIR=./chroma_db

# Seuil de score RAG minimum — calibré pour text-embedding-3-small + ISTQB
# Les scores cosinus sur documents techniques plafonnent à ~0.25
# 0.10 = permissif (meilleur rappel) | 0.15 = sélectif (meilleure précision)
RAG_SCORE_THRESHOLD=0.10

# Nombre de chunks RAG récupérés
# 5 = meilleure couverture ISTQB (évalué par RAGAS : recall=0.50 vs 0.20 avec top_k=3)
RAG_TOP_K=5

# Reranking cross-encoder après retrieval ChromaDB (true/false)
# Améliore context_precision (+0.15 à +0.30) — ~50ms CPU par requête
# Modèle : cross-encoder/ms-marco-MiniLM-L-6-v2 (~90 Mo, cache HuggingFace)
RAG_RERANKER_ENABLED=true

# ── Langfuse — observabilité LLM (optionnel) ─────────────────────────────────
# Créez un compte sur https://cloud.langfuse.com (ou auto-hébergez)
# puis copiez vos clés depuis Project Settings > API Keys.
# Laisser vide pour désactiver le tracing (l'app tourne normalement).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Cloud EU (défaut) | Cloud US : https://us.cloud.langfuse.com | Self-hosted : http://localhost:3000
LANGFUSE_HOST=https://cloud.langfuse.com
